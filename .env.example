# Copy to .env.local and fill in real values. Never commit .env.local.

# Safe to expose client-side -- protected by RLS (both tables default-deny
# with zero policies, so the publishable key alone cannot read or write them).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses RLS -- never expose to the client, never commit.
# Used by src/proxy.ts (honeypot logging) and the /api/contact route handler.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to salt IP hashes before they're stored. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_IP_HASH_SALT=

# Transactional email for contact-form notifications. Not wired up yet --
# needs an account (e.g. Resend) since none exists in api-keys.json.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=oliverstraus246@gmail.com
