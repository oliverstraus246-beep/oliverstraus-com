# Copy to .env.local and fill in real values. Never commit .env.local.

# Safe to expose client-side -- protected by RLS (both tables default-deny
# with zero policies, so the publishable key alone cannot read or write them).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses RLS -- never expose to the client, never commit.
# Used by src/proxy.ts (honeypot logging) and the /api/contact route handler.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to salt IP hashes before they're stored. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_IP_HASH_SALT=

# Transactional email for contact-form notifications. Not wired up yet --
# needs an account (e.g. Resend) since none exists in api-keys.json.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=oliverstraus246@gmail.com

# Vercel Blob storage for downloadable project releases (scripts/release-*.mjs
# writes here; the download route only ever reads a blob_url string already
# stored in Supabase, so this token is never needed at request time).
# NOT YET PROVISIONED (2026-10-02): Vercel MCP lacks permission to create/list
# Storage or env vars on this project (403 forbidden on every storage/
# integration/env write and list call) -- needs a store created manually via
# the Vercel dashboard (Storage tab) or `vercel blob create-store`, then
# `vercel env pull .env.local` to populate this locally. See task-3-report.md.
BLOB_READ_WRITE_TOKEN=
